@article{RocknerSunXieStrongWeak2019,
  title = {Strong and Weak Convergence in the Averaging Principle for {{SDEs}}
           with {{H}}{\textbackslash}"older Coefficients},
  author = {R{\"o}ckner, Michael and Sun, Xiaobin and Xie, Longjie},
  year = {2019},
  month = jul,
  number = {arXiv:1907.09256},
  eprint = {1907.09256},
  primaryclass = {math},
  publisher = {arXiv},
  url = {http://arxiv.org/abs/1907.09256},
  urldate = {2024-06-07},
  abstract = {Using Zvonkin's transform and the Poisson equation in Rd with a
              parameter, we prove the averaging principle for stochastic
              differential equations with timedependent Ho{\textasciidieresis}
              lder continuous coefficients. Sharp convergence rates with order ({
              $\alpha$} {$\wedge$} 1)/2 in the strong sense and ({$\alpha$}/2) {$
              \wedge$} 1 in the weak sense are obtained, considerably extending
              the existing results in the literature. Moreover, we prove that the
              convergence of the multi-scale system to the effective equation
              depends only on the regularity of the coefficients of the equation
              for the slow variable, and does not depend on the regularity of the
              coefficients of the equation for the fast component.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {Mathematics - Probability},
}

@article{BakhtinKiferDiffusionApproximation2004,
  title = {Diffusion Approximation for Slow Motion in Fully Coupled Averaging},
  author = {Bakhtin, Victor and Kifer, Yuri},
  year = {2004},
  month = jun,
  journal = {Probability Theory and Related Fields},
  volume = {129},
  number = {2},
  pages = {157--181},
  issn = {0178-8051, 1432-2064},
  doi = {10.1007/s00440-003-0326-7},
  urldate = {2024-12-03},
  abstract = {In systems which combine fast and slow motions it is usually
              impossible to study directly corresponding two scale equations and
              the averaging principle suggests to approximate the slow motion by
              averaging in fast variables. We consider the averaging setup when
              both fast and slow motions are diffusion processes depending on
              each other (fully coupled) and show that there exists a diffusion
              process which approximates the slow motion in the L2 sense much
              better than the averaged motion prescribed by the averaging
              principle.},
  langid = {english},
}


